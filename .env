# Configuração do rate limiter. Variáveis do ambiente têm prioridade sobre
# este arquivo. Referência completa no README.

# Requisições por segundo aceitas por IP.
RATE_LIMIT_IP=10

# Limites por token (header API_KEY), com precedência sobre o limite de IP.
# Formato: token:limite[:bloqueio], separados por vírgula.
RATE_LIMIT_TOKENS=abc123:100,def456:50:1m

# Tempo em que o IP/token fica bloqueado depois de exceder o limite.
RATE_LIMIT_BLOCK_DURATION=5m

# Tamanho da janela de contagem (1s = requisições por segundo).
RATE_LIMIT_WINDOW=1s

# Estratégia de persistência: redis ou memory.
RATE_LIMIT_STORE=redis

# Proxies confiáveis (CIDRs/IPs) cujos X-Forwarded-For/X-Real-IP são lidos.
# Vazio = usa sempre o IP da conexão.
RATE_LIMIT_TRUSTED_PROXIES=

# true deixa passar as requisições se o Redis cair; false responde 503.
RATE_LIMIT_FAIL_OPEN=false

# Conexão com o Redis (no docker compose o REDIS_ADDR é forçado para redis:6379).
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

PORT=8080
